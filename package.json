{
  "name": "echo-notes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server/index.js --bundle --platform=node --format=cjs --outfile=server/.build/index.js --external:express --external:multer --minify",
    "start": "node server/.build/index.js",
    "lint": "next lint",
    "cap:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@huggingface/transformers": "^4.3.0",
    "@supabase/ssr": "^0.12.7",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
