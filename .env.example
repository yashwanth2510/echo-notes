# Optional per-user note sync (Supabase). Leave empty to run fully offline/local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional in-browser model overrides (defaults below work out of the box)
# Total default download ~560 MB (Whisper 73 MB + Qwen 488 MB).
# Use "Transcript" output mode to skip the Qwen summary model (~73 MB total).
#
# Faster/even smaller Whisper: Xenova/whisper-tiny (~39 MB, weaker accuracy).
# Better accuracy (heavier):      Xenova/whisper-small (~238 MB).
NEXT_PUBLIC_WHISPER_MODEL=Xenova/whisper-base
NEXT_PUBLIC_WHISPER_DTYPE=q8
NEXT_PUBLIC_LLM_MODEL=onnx-community/Qwen2.5-0.5B-Instruct
NEXT_PUBLIC_LLM_DTYPE=q8
NEXT_PUBLIC_TRANSFORMER_DEVICE=wasm