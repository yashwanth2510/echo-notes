# Your OpenRouter API key (get one free at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: change the model. Must support AUDIO input on OpenRouter.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional: shown to OpenRouter for analytics/ranking
SITE_URL=http://localhost:3000
SITE_NAME=Voice MOM App
