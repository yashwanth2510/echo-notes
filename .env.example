# Transcription (free) — create a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here
GROQ_WHISPER_MODEL=whisper-large-v3

# Summarization — OpenRouter key (free text models work with $0 balance)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: audio-capable model, only used if GROQ_API_KEY is not set
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash

# Optional: shown to OpenRouter for analytics/ranking
SITE_URL=http://localhost:3000
SITE_NAME=Echo Notes
