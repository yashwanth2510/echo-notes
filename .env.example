# --- Hosted AI (server-side only; used by server/index.js on Render) ---
# Keys live on the server, never in the browser. Leave AI_API_KEY empty to run
# fully on-device (the UI auto-selects on-device when the server has no key).
# OpenAI:  AI_API_BASE=https://api.openai.com/v1      models: whisper-1 / gpt-4o-mini
# Groq:    AI_API_BASE=https://api.groq.com/openai/v1 models: whisper-large-v3 / llama-3.3-70b-versatile
AI_API_KEY=
AI_API_BASE=https://api.groq.com/openai/v1
AI_TRANSCRIBE_MODEL=whisper-large-v3
AI_CHAT_MODEL=llama-3.3-70b-versatile
# Origins allowed to call /api/* (Android app calls from https://localhost)
ALLOWED_ORIGINS=https://echo-notes-ap43.onrender.com,https://localhost,http://localhost

# Optional: absolute origin of the AI backend for the packaged app.
# Empty on the web build (same-origin). The APK build sets this to the Render URL.
NEXT_PUBLIC_API_BASE=

# Optional per-user note sync (Supabase). Leave empty to run fully offline/local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional in-browser model overrides (defaults below work out of the box)
# Total default download ~1 GB (Whisper 540 MB + Qwen 490 MB).
# Use "Transcript" output mode to skip the Qwen summary model (~540 MB total).
#
# Default = best multilingual accuracy (whisper-large-v3-turbo @ q4f16).
# Lighter/faster Whisper:      Xenova/whisper-base ~73 MB (q8), weaker on non-English.
#                              Xenova/whisper-small ~238 MB (q8).
NEXT_PUBLIC_WHISPER_MODEL=onnx-community/whisper-large-v3-turbo
NEXT_PUBLIC_WHISPER_DTYPE=q4f16
NEXT_PUBLIC_LLM_MODEL=onnx-community/Qwen2.5-0.5B-Instruct
NEXT_PUBLIC_LLM_DTYPE=q8
NEXT_PUBLIC_TRANSFORMER_DEVICE=wasm